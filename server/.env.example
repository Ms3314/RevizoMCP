# Copy to .env and fill in your Supabase Session Pooler connection string.
# Use the SESSION POOLER URI (port 5432), not the transaction pooler (6543).
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# OAuth / identity (APP_BASE_URL is the public https URL when deployed)
APP_BASE_URL=http://localhost:8000
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
SUPABASE_OAUTH_PROVIDER=google

# Fernet key used to encrypt LeetCode session cookies at rest. Generate once:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this value stable and secret; changing it makes saved cookies unreadable.
LEETCODE_SESSION_ENCRYPTION_KEY=<generate-a-fernet-key>

# MCP transport: 0 = stateful (Cursor-friendly), 1 = stateless (required on serverless e.g. Vercel)
MCP_STATELESS=0
